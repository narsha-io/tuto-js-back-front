{
  "compilerOptions": {
    /* Modules */
    "module": "CommonJS", // Le système de module utilisé par Node.js.
    "rootDir": "./src", // Indique où sont nos fichiers sources (nous allons créer ce dossier).
    "outDir": "./dist", // Indique où seront placés les fichiers JavaScript compilés.
    "moduleResolution": "node", // Comment le compilateur trouve les modules.
    /* Émissions */
    "target": "es2020", // Cible la version ECMAScript que Node.js peut exécuter.
    "esModuleInterop": true, // Améliore l'interopérabilité des imports/exports CommonJS et ES Modules (important pour Express).
    "forceConsistentCasingInFileNames": true, // Assure l'uniformité des noms de fichiers.
    /* Typage */
    "strict": true, // Active toutes les vérifications de type strictes (fortement recommandé, comme en Java).
    "skipLibCheck": true, // Ignore les vérifications de type pour les librairies installées (accélère la compilation).
    "resolveJsonModule": true, // Permet l'importation de fichiers JSON.
    "sourceMap": true, // Génère les 'source maps' pour le debugging.
    /* Chemin des fichiers */
    "baseUrl": "src",
    "paths": {
      "@controllers/*": [
        "controllers/*"
      ], // Le chemin virtuel @controllers pointe vers ./src/controllers
      "@services/*": [
        "services/*"
      ], // @services pointe vers ./src/services
      "@interfaces/*": [
        "interfaces/*"
      ], // @interfaces pointe vers ./src/interfaces
      "@routes/*": [
        "routes/*"
      ] // @routes pointe vers ./src/routes
    },
  },
  "include": [
    "src/**/*"
  ], // Quels fichiers compiler.
  "exclude": [
    "node_modules"
  ] // Quels dossiers ignorer.
}